# Required model provider credential.
GLM_API_KEY=

# Required Telegram settings. For a personal DM, both IDs are identical.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=
TELEGRAM_HOME_CHANNEL=

# Public, non-secret defaults used by the Railway deployment.
TELEGRAM_HOME_CHANNEL_NAME=Personal DM
HERMES_HUMAN_DELAY_MODE=natural
